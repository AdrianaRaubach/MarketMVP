{
    "name": "aula02",
    "version": "1.0.0",
    "description": "TypeScript + Express starter project",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "dev:container": "ts-node-dev --respawn --transpile-only --poll src/index.ts",
        "dev:docker": "docker compose --profile dev up --build app-dev",
        "dev:docker:down": "docker compose --profile dev down",
        "build": "tsc",
        "start": "node dist/index.js",
        "migrate": "npx prisma migrate dev",
        "format": "prettier --write \"src/**/*.{ts,js,ejs}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js,ejs}\"",
        "lint": "eslint \"src/**/*.ts\" --fix",
        "lint:check": "eslint \"src/**/*.ts\"",
        "seed": "ts-node prisma/seed.ts"
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.910.0",
        "@prisma/client": "5.9.1",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^12.8.0",
        "dotenv": "^17.3.1",
        "ejs": "4.0.1",
        "express": "4.21.2",
        "express-session": "^1.19.0",
        "multer": "^2.0.2",
        "nodemailer": "^8.0.5",
        "sqlite": "^5.1.1",
        "sqlite3": "5.1.7",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/multer": "^2.0.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/express": "4.17.21",
        "@types/express-session": "^1.18.2",
        "@types/node": "22.13.10",
        "@typescript-eslint/eslint-plugin": "^8.58.1",
        "@typescript-eslint/parser": "^8.58.1",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "prettier": "^3.8.2",
        "prisma": "5.9.1",
        "ts-node-dev": "2.0.0",
        "typescript": "5.8.2"
    }
}
