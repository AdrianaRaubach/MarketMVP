generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./ecommerce.db"
}

model Person {
  id              Int                  @id @default(autoincrement())
  first_name      String
  last_name       String
  email           String               @unique
  cpf             String?              @unique
  phone           String?
  payment_method  String?
  type            String               @default("customer")
  store_description String?
  blocked         Boolean              @default(false)
  verified_email  Boolean              @default(false)
  last_login      DateTime?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @default(now()) @updatedAt

  user            User?
  categories      String?
  email_verifications EmailVerification[]
  Addresses  Address[]

  @@map("persons")
}

model User {
  id            Int      @id @default(autoincrement())
  person_id     Int      @unique
  hash_password String
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  person        Person   @relation(fields: [person_id], references: [id], onDelete: Restrict)
  products      Product[]

  @@map("users")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  category    String
  price       Float
  stock       Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  seller_id   Int
  seller      User     @relation(fields: [seller_id], references: [id], onDelete: Restrict)

  images      ProductImage[]

  @@map("products")
}

model ProductImage {
  id          Int      @id @default(autoincrement())
  imageUrl    String?
  imageStorage String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  product_id   Int
  product      Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@map("product_images")
}

model EmailVerification {
  id          Int      @id @default(autoincrement())
  person_id   Int
  code        String
  expires_at  DateTime
  attempts    Int      @default(0)
  verified_at DateTime?
  created_at  DateTime @default(now())

  person      Person   @relation(fields: [person_id], references: [id])

  @@map("email_verifications")
}

model Log {
  id             Int      @id @default(autoincrement())
  user_id        Int
  method         String
  endpoint       String
  action_summary String
  created_at     DateTime @default(now())

  @@map("logs")
}


model Address {
  id        Int      @id @default(autoincrement())
  street    String
  city      String
  state     String
  zipCode   String
  complement String
  number    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person_id    Int
  Person      Person     @relation(fields: [person_id], references: [id])

  @@map("address")
}
