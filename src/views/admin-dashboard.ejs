<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MarketMVP | Painel administrativo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ["Space Grotesk", "sans-serif"],
              body: ["Plus Jakarta Sans", "sans-serif"],
            },
            colors: {
              brand: { 50: "#F8F7F2", 100: "#EDE8D8", 200: "#D9CEAA", 300: "#C7B57D", 400: "#B99B56", 500: "#A8853A", 600: "#886B2F", 700: "#665024", 800: "#43361A", 900: "#251E10" },
              accent: { 500: "#0A7D7A", 600: "#075F5D" },
              coral: { 500: "#E66A4E", 600: "#C85339" },
            },
          },
        },
      };
    </script>
    <style>
      .grid-bg {
        background-image: radial-gradient(#d9ceaa 0.8px, transparent 0.8px), radial-gradient(#d9ceaa 0.8px, #f8f7f2 0.8px);
        background-size: 28px 28px;
        background-position: 0 0, 14px 14px;
      }
    </style>
  </head>
  <body class="font-body bg-brand-50 text-brand-900">
    <div class="min-h-screen grid-bg">
      <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
          <a href="/" class="font-display text-xl font-bold">MarketMVP</a>
          <nav class="hidden gap-5 text-sm font-medium md:flex">
            <a href="/" class="hover:text-accent-600">Início</a>
            <a href="seller-dashboard" class="hover:text-accent-600">Painel do vendedor</a>
            <a href="/admin-dashboard" class="text-accent-600 font-semibold">Painel administrativo</a>
            <a href="/admin-logs" class="hover:text-accent-600">Logs do sistema</a>
            <a href="orders" class="hover:text-accent-600">Pedidos</a>
            <a href="/logout" class="hover:text-accent-600">Sair</a>
          </nav>
        </div>
      </header>

      <main class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
        <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Controle global da plataforma</p>
              <h1 class="mt-1 font-display text-3xl font-bold">Painel administrativo</h1>
              <p class="mt-2 max-w-2xl text-sm text-brand-700">Acompanhe contas cadastradas, identifique perfis com risco operacional e desative acessos quando necessário.</p>
            </div>
            <div class="rounded-2xl bg-brand-100 px-4 py-3 text-sm font-semibold text-brand-800">
              Administrador autenticado: admin@marketmvp.com
            </div>
          </div>
          <div class="mt-5 grid gap-3 sm:grid-cols-3">
            <div class="rounded-2xl bg-brand-100 p-4">
              <p class="text-xs font-semibold uppercase tracking-wider">Contas totais</p>
              <p id="total-accounts" class="mt-2 font-display text-3xl font-bold"><%= count %></p>
            </div>
            <div class="rounded-2xl bg-brand-100 p-4">
              <p class="text-xs font-semibold uppercase tracking-wider">Contas ativas</p>
              <p id="active-accounts" class="mt-2 font-display text-3xl font-bold"><%= count - total_blocked %></p>
            </div>
            <div class="rounded-2xl bg-brand-100 p-4">
              <p class="text-xs font-semibold uppercase tracking-wider">Contas desativadas</p>
              <p id="deactivated-today" class="mt-2 font-display text-3xl font-bold"><%= total_blocked %></p>
            </div>
          </div>
        </section>

        <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <form class="flex flex-wrap items-center justify-between gap-3" action="/admin-dashboard" method="POST">
            <div>
              <h2 class="font-display text-2xl font-bold">Lista de contas</h2>
              <p class="mt-1 text-sm text-brand-700">Visualize compradores, vendedores e administradores em uma única visão operacional.</p>
            </div>
            <div class="flex gap-2">
              <input type="text" name="name" placeholder="Buscar por nome, e-mail ou perfil" class="rounded-xl border border-brand-300 px-4 py-2 outline-none ring-accent-500 focus:ring" />
              <button class="rounded-xl bg-accent-500 px-4 py-2 font-semibold text-white hover:bg-accent-600" type="submit">Buscar</button>
            </div>
          </form>

          <div class="mt-4 overflow-x-auto rounded-2xl border border-brand-200">
            <table class="min-w-full text-left text-sm">
              <thead class="bg-brand-100 text-brand-800">
                <tr>
                  <th class="px-4 py-3 font-semibold">Conta</th>
                  <th class="px-4 py-3 font-semibold">Perfil</th>
                  <th class="px-4 py-3 font-semibold">E-mail</th>
                  <th class="px-4 py-3 font-semibold">Último acesso</th>
                  <th class="px-4 py-3 font-semibold">Status</th>
                  <th class="px-4 py-3 font-semibold">Ações</th>
                </tr>
              </thead>
                <tbody class="divide-y divide-brand-200 bg-white">
                  <% persons.forEach(person => { %>
                  <tr data-account-row data-person-id="<%= person.id %>">
                    <td class="px-4 py-3 font-semibold"><%= person.first_name %> <%= person.last_name %></td>
                    <td class="px-4 py-3">
                      <% if(person.type === 'admin') { %>
                        Administrador
                      <% } else if(person.type === 'seller') { %>
                        Vendedor
                      <% } else { %>
                        Comprador
                      <% } %>
                    </td>
                    <td class="px-4 py-3"><%= person.email %></td>
                    <td class="px-4 py-3">
                      <%= person.last_login ? new Date(person.last_login).toLocaleString('pt-BR') : 'Nunca acessou' %>
                    </td>
                    <td class="px-4 py-3">
                      <span class="rounded-full px-2 py-1 text-xs font-semibold <%= person.blocked ? 'bg-brand-200 text-brand-700' : 'bg-accent-500/10 text-accent-600' %>">
                        <%= person.blocked ? 'Desativada' : 'Ativa' %>
                      </span>
                    </td>
                    <td class="px-4 py-3">
                      <form action="/block-user/<%= person.id %>" method="POST" style="display: inline;">
                        <button type="submit" class="rounded-lg px-3 py-1.5 font-semibold <%= person.blocked ? 'border border-brand-300 hover:bg-brand-100 text-brand-700' : 'bg-coral-500 text-white hover:bg-coral-600' %>">
                          <%= person.blocked ? 'Reativar conta' : 'Desativar conta' %>
                        </button>
                      </form>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
