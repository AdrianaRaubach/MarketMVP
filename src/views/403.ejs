<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MarketMVP | Acesso Negado</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
        theme: {
            extend: {
            fontFamily: {
                display: ["Space Grotesk", "sans-serif"],
                body: ["Plus Jakarta Sans", "sans-serif"],
            },
            colors: {
                brand: { 50: "#F8F7F2", 100: "#EDE8D8", 200: "#D9CEAA", 300: "#C7B57D", 400: "#B99B56", 500: "#A8853A", 600: "#886B2F", 700: "#665024", 800: "#43361A", 900: "#251E10" },
                accent: { 500: "#0A7D7A", 600: "#075F5D" },
                coral: { 500: "#E66A4E", 600: "#C85339" },
            },
            },
        },
        };
    </script>
    <style>
        .grid-bg {
        background-image: radial-gradient(#d9ceaa 0.8px, transparent 0.8px), radial-gradient(#d9ceaa 0.8px, #f8f7f2 0.8px);
        background-size: 28px 28px;
        background-position: 0 0, 14px 14px;
        }
    </style>
</head>

<body class="font-body bg-brand-50 text-brand-900">
    <div class="min-h-screen grid-bg">
        <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
            <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
                <a href="/" class="font-display text-xl font-bold">MarketMVP</a>
                <nav class="flex items-center gap-3 text-sm font-semibold">
                    <% if (!user) { %>
                        <a href="/login" class="rounded-full border border-brand-300 px-4 py-2 hover:bg-brand-100">Entrar</a>
                        <a href="/signup" class="rounded-full bg-brand-900 px-4 py-2 text-brand-50 hover:bg-brand-800">Criar conta</a>
                    <% } else { %>
                        <a href="/logout" class="rounded-full border border-brand-300 px-4 py-2 hover:bg-brand-100">Sair</a>
                    <% } %>
                </nav>
            </div>
        </header>

        <main class="mx-auto flex max-w-7xl items-center justify-center px-4 py-16 sm:px-6 lg:px-8">
            <section class="w-full max-w-md text-center">
                <!-- Ícone de acesso negado -->
                <div class="mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-full bg-coral-500/10">
                    <svg class="h-12 w-12 text-coral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m0 0v2m0-2h2m-2 0H9m3-12a4 4 0 00-4 4v4a4 4 0 008 0V7a4 4 0 00-4-4z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4v2" />
                    </svg>
                </div>

                <!-- Título e mensagem -->
                <h1 class="font-display text-4xl font-bold text-brand-900">Acesso Negado</h1>
                <div class="mt-3 rounded-xl bg-coral-500/10 p-4">
                    <p class="text-coral-700 font-medium">
                        <%= error || 'Você não tem permissão para acessar esta página.' %>
                    </p>
                </div>

                <!-- Código do erro -->
                <p class="mt-4 text-sm font-mono text-brand-500">Erro 403 - Forbidden</p>

                <!-- Botões de ação -->
                <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
                    <a href="/" class="rounded-xl border border-brand-300 px-6 py-2.5 font-semibold text-brand-700 hover:bg-brand-100 transition-colors">
                        ← Voltar para o início
                    </a>
                    <% if (!user) { %>
                        <a href="/login" class="rounded-xl bg-brand-900 px-6 py-2.5 font-semibold text-brand-50 hover:bg-brand-800 transition-colors">
                            Fazer login
                        </a>
                    <% } else { %>
                        <a href="/logout" class="rounded-xl bg-coral-500 px-6 py-2.5 font-semibold text-white hover:bg-coral-600 transition-colors">
                            Sair e tentar novamente
                        </a>
                    <% } %>
                </div>
            </section>
        </main>
    </div>
</body>

</html>
