<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MarketMVP | Logs do Sistema</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ["Space Grotesk", "sans-serif"],
              body: ["Plus Jakarta Sans", "sans-serif"],
            },
            colors: {
              brand: { 50: "#F8F7F2", 100: "#EDE8D8", 200: "#D9CEAA", 300: "#C7B57D", 400: "#B99B56", 500: "#A8853A", 600: "#886B2F", 700: "#665024", 800: "#43361A", 900: "#251E10" },
              accent: { 500: "#0A7D7A", 600: "#075F5D" },
              coral: { 500: "#E66A4E", 600: "#C85339" },
            },
          },
        },
      };
    </script>
    <style>
      .grid-bg {
        background-image: radial-gradient(#d9ceaa 0.8px, transparent 0.8px), radial-gradient(#d9ceaa 0.8px, #f8f7f2 0.8px);
        background-size: 28px 28px;
        background-position: 0 0, 14px 14px;
      }
    </style>
</head>
<body class="font-body bg-brand-50 text-brand-900">
    <div class="min-h-screen grid-bg">
        <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
            <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
                <a href="/" class="font-display text-xl font-bold">MarketMVP</a>
                <nav class="hidden gap-5 text-sm font-medium md:flex">
                    <a href="/" class="hover:text-accent-600">Início</a>
                    <a href="seller-dashboard" class="hover:text-accent-600">Painel do vendedor</a>
                    <a href="/admin-dashboard" class="hover:text-accent-600">Painel administrativo</a>
                    <a href="/admin/logs" class="text-accent-600 font-semibold">Logs do sistema</a>
                    <a href="/logout" class="hover:text-accent-600">Sair</a>
                </nav>
            </div>
        </header>

        <main class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
            <!-- Seção de título -->
            <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
                <div class="flex flex-wrap items-start justify-between gap-4">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Auditoria da plataforma</p>
                        <h1 class="mt-1 font-display text-3xl font-bold">Logs do sistema</h1>
                        <p class="mt-2 max-w-2xl text-sm text-brand-700">Registro detalhado de todas as ações realizadas na plataforma. Apenas administradores têm acesso a este histórico.</p>
                    </div>
                    <div class="rounded-2xl bg-brand-100 px-4 py-3 text-sm font-semibold text-brand-800">
                        Total de registros: <%= total %>
                    </div>
                </div>
            </section>

            <section class="rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                    <div>
                        <h2 class="font-display text-2xl font-bold">Histórico de ações</h2>
                        <p class="mt-1 text-sm text-brand-700">Todas as operações POST, PUT, PATCH e DELETE realizadas na plataforma.</p>
                    </div>
                </div>

                <div class="mt-4 overflow-x-auto rounded-2xl border border-brand-200">
                    <table class="min-w-full text-left text-sm">
                        <thead class="bg-brand-100 text-brand-800">
                            <tr>
                                <th class="px-4 py-3 font-semibold">Data/Hora</th>
                                <th class="px-4 py-3 font-semibold">Usuário</th>
                                <th class="px-4 py-3 font-semibold">Método</th>
                                <th class="px-4 py-3 font-semibold">Endpoint</th>
                                <th class="px-4 py-3 font-semibold">Ação</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-brand-200 bg-white">
                            <% if (logs.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="px-4 py-8 text-center text-brand-500">
                                        Nenhum registro de log encontrado
                                    </td>
                                </tr>
                            <% } else { %>
                                <% logs.forEach(log => { %>
                                    <tr class="hover:bg-brand-50 transition-colors">
                                        <td class="px-4 py-3 text-sm text-brand-900 whitespace-nowrap">
                                            <%= new Date(log.created_at).toLocaleString('pt-BR') %>
                                        </td>
                                        <td class="px-4 py-3 text-sm">
                                            <% if (log.user_id > 0) { %>
                                                <div class="font-medium text-brand-900"><%= log.user_email %></div>
                                                <div class="text-xs text-brand-600"><%= log.user_name %></div>
                                            <% } else { %>
                                                <span class="text-brand-500">Sistema / Não autenticado</span>
                                            <% } %>
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="inline-flex rounded-full px-2 py-1 text-xs font-semibold 
                                                <%= log.method === 'POST' ? 'bg-accent-500/10 text-accent-600' : 
                                                   log.method === 'PUT' ? 'bg-brand-200 text-brand-700' :
                                                   log.method === 'DELETE' ? 'bg-coral-500/10 text-coral-600' :
                                                   'bg-brand-100 text-brand-600' %>">
                                                <%= log.method %>
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-sm font-mono text-brand-700">
                                            <%= log.endpoint %>
                                        </td>
                                        <td class="px-4 py-3 text-sm text-brand-900">
                                            <%= log.action_summary %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <% if (totalPages > 1) { %>
                    <div class="flex justify-center gap-2 mt-6">
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <a href="/admin/logs?page=<%= i %>" 
                               class="px-3 py-1 rounded-lg text-sm font-semibold transition-colors
                                   <%= currentPage === i ? 'bg-brand-900 text-brand-50' : 'bg-brand-100 text-brand-700 hover:bg-brand-200' %>">
                                <%= i %>
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </section>
        </main>
    </div>
</body>
</html>