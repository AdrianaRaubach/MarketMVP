<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MarketMVP | Detalhes do produto</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ["Space Grotesk", "sans-serif"],
              body: ["Plus Jakarta Sans", "sans-serif"],
            },
            colors: {
              brand: { 50: "#F8F7F2", 100: "#EDE8D8", 200: "#D9CEAA", 300: "#C7B57D", 400: "#B99B56", 500: "#A8853A", 600: "#886B2F", 700: "#665024", 800: "#43361A", 900: "#251E10" },
              accent: { 500: "#0A7D7A", 600: "#075F5D" },
              coral: { 500: "#E66A4E", 600: "#C85339" },
            },
          },
        },
      };
    </script>
    <style>
      .grid-bg {
        background-image: radial-gradient(#d9ceaa 0.8px, transparent 0.8px), radial-gradient(#d9ceaa 0.8px, #f8f7f2 0.8px);
        background-size: 28px 28px;
        background-position: 0 0, 14px 14px;
      }
    </style>
  </head>
  <body class="font-body bg-brand-50 text-brand-900">
    <div class="min-h-screen grid-bg">
      <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
          <a href="/" class="flex items-center gap-3">
            <div class="h-9 w-9 rounded-lg bg-gradient-to-br from-coral-500 to-brand-500">
              <i class="fa-solid fa-cat p-2.5 text-white"></i>
            </div>
            <div>
              <p class="font-display text-xl font-bold tracking-tight">MarketMVP</p>
              <p class="text-xs text-brand-700">compre, anuncie e gerencie em um só lugar</p>
            </div>
          </a>
          <nav class="hidden items-center gap-5 text-sm font-medium text-brand-800 md:flex">
            <!-- <a href="/orders" class="hover:text-accent-600">Meus pedidos</a> -->
            <a href="/seller-dashboard" class="hover:text-accent-600">Painel do vendedor</a>
            <a href="/admin-dashboard" class="hover:text-accent-600">Painel admin</a>
          </nav>
          <div class="flex items-center gap-2">
            <% if (user) { %>
              <span class="hidden rounded-full bg-brand-100 px-3 py-1 text-sm font-semibold text-brand-700 md:inline-flex">
                Olá, <%= user.name %>!
              </span>
              <a href="/profile" class="font-semibold rounded-full border border-brand-300 hover:bg-brand-100 px-2 py-1 text-brand-600">
                <i class="fa-solid fa-circle-user"></i>
              </a>
              <a href="/logout" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">Sair</a>
            <% } else { %>
              <a href="/login" class="rounded-full border border-brand-300 px-4 py-2 text-sm font-semibold hover:bg-brand-100">Entrar</a>
              <a href="/signup" class="rounded-full bg-brand-900 px-4 py-2 text-sm font-semibold text-brand-50 hover:bg-brand-800">Criar conta</a>
            <% } %>
          </div>
        </div>
      </header>

      <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <section class="grid gap-6 rounded-3xl border border-brand-200 bg-white p-6 shadow-sm md:grid-cols-2">
          <div class="rounded-2xl bg-brand-100 p-6">
            <div class="flex flex-col gap-3">
              <div class="flex h-80 items-center justify-center rounded-xl border border-brand-200 bg-white">
                <% if (product.images && product.images.length > 0) { %>
                  <img src="<%= product.images[0].imageUrl %>" alt="<%= product.name %>" class="h-full w-full rounded-xl object-contain p-2" />
                <% } else { %>
                  <div class="flex h-64 w-full items-center justify-center rounded-xl text-sm text-brand-700">
                    Produto sem imagem
                  </div>
                <% } %>
              </div>
              <% if (product.images && product.images.length > 1) { %>
                <div class="flex gap-2 overflow-x-auto">
                  <% product.images.forEach(function(image, index) { %>
                    <img
                      src="<%= image.imageUrl %>"
                      alt="<%= product.name %> - imagem <%= index + 1 %>"
                      class="h-16 w-16 cursor-pointer rounded-lg border-2 border-brand-200 object-cover hover:border-accent-500"
                      onclick="changeMainImage(this.src)"
                    />
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">
              <%= getProductCategoryLabel(product.category) %>
            </p>
            <h1 class="mt-1 font-display text-3xl font-bold flex items-center justify-between">
              <%= product.name %>
              <button
                data-product-id="<%= product.id %>"
                id="like-btn-<%= product.id %>"
                class="like-btn transition-all duration-200 hover:scale-110 focus:outline-none"
              >
                <i id="like-icon-<%= product.id %>" class="fa-<%= userLiked ? 'solid' : 'regular' %> fa-heart text-2xl <%= userLiked ? 'text-red-500' : 'text-gray-400 hover:text-red-400' %>"></i>
              </button>
            </h1>

            <!-- Mostrar total de likes -->
            <p id="likes-count-<%= product.id %>" class="text-sm text-brand-600 mt-1">
              <i class="fa-regular fa-heart mr-1"></i> <%= totalLikes %> pessoas curtiram este produto
            </p>
            <p class="mt-2 text-sm text-brand-700">
              <a href="/profile-seller-public/<%= product.seller.person.id %>" class="font-semibold text-brand-600 hover:text-accent-600">
                Vendedor: <%= product.seller.person.first_name %> <%= product.seller.person.last_name %>
              </a>
            </p>
            <p class="mt-4 text-brand-700"><%= product.description %></p>
            <p class="mt-5 font-display text-4xl font-bold text-coral-600">
              R$ <%= product.price.toFixed(2).replace('.', ',') %>
            </p>
            <p class="mt-2 text-sm text-brand-600">
              Estoque: <%= product.stock %> unidades
            </p>
            <p class="mt-2 text-sm text-brand-600">
              Categoria: <%= product.category %>
            </p>
            <div class="mt-5 flex flex-wrap gap-3">
              <button class="rounded-xl bg-brand-900 px-5 py-2.5 font-semibold text-brand-50 hover:bg-brand-800">
                Adicionar ao carrinho
              </button>
            </div>
          </div>
        </section>
        <section class="mt-3 rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-brand-600">Comentários</h3>
          <div class="mt-4">
            <% if (product.comments && product.comments.length > 0) { %>
              <ul class="divide-y divide-brand-200">
                <% for (var i = 0; i < product.comments.length; i++) { %>
                  <% var comment = product.comments[i]; %>
                  <li class="py-4">
                    <div class="flex justify-between items-start">
                      <div class="flex-1">
                        <p class="font-semibold text-brand-800">
                          <%= comment.user.person.first_name %> <%= comment.user.person.last_name %>
                        </p>
                        <p class="text-sm text-brand-700 mt-1"><%= comment.content %></p>

                        <!-- Imagens do comentário -->
                        <% if (comment.images && comment.images.length > 0) { %>
                          <div class="flex gap-2 mt-2 flex-wrap">
                            <% for (var j = 0; j < comment.images.length; j++) { %>
                              <% var image = comment.images[j]; %>
                              <img
                                src="<%= image.imageUrl %>"
                                alt="Imagem do comentário"
                                class="h-20 w-20 rounded-lg object-cover cursor-pointer hover:opacity-80"
                                onclick="openImageModal('<%= image.imageUrl %>')"
                              />
                            <% } %>
                          </div>
                        <% } %>

                        <p class="mt-1 text-xs text-brand-500">
                          <%= new Date(comment.created_at).toLocaleDateString('pt-BR') %>
                        </p>
                      </div>
                      <% if (user && (user.id === comment.user.id || user.type === 'admin')) { %>
                        <button onclick="deleteComment('<%= comment.id %>')" class="text-red-500 hover:text-red-700 ml-4">
                          <i class="fa-regular fa-trash-alt"></i>
                        </button>
                      <% } %>
                    </div>
                  </li>
                <% } %>
              </ul>
            <% } else { %>
              <p class="text-sm text-brand-700">Nenhum comentário ainda. Seja o primeiro a comentar!</p>
            <% } %>
          </div>

          <!-- Formulário de comentário COM imagens -->
          <form action="/product-details/<%= product.id %>/comment" method="POST" enctype="multipart/form-data" class="mt-6">
            <div class="mb-4">
              <label class="mb-1 block text-sm font-medium text-brand-700">Deixe seu comentário</label>
              <textarea
                name="content"
                rows="3"
                required
                class="w-full rounded-xl border border-brand-300 px-4 py-2.5 outline-none ring-coral-500 focus:ring"
                placeholder="Escreva seu comentário aqui..."
              ></textarea>
            </div>

            <div class="mb-4">
              <label class="mb-1 block text-sm font-medium text-brand-700">Imagens do comentário (máximo 5)</label>
              <input
                name="comment_images"
                type="file"
                multiple
                accept="image/png,image/jpeg,image/webp,image/gif"
                class="w-full rounded-xl border border-brand-300 px-4 py-2.5 text-sm outline-none ring-coral-500 file:mr-4 file:rounded-lg file:border-0 file:bg-brand-100 file:px-3 file:py-2 file:font-semibold file:text-brand-800 hover:file:bg-brand-200 focus:ring"
              />
              <span class="mt-2 block text-xs text-brand-600">Envie até 5 imagens (JPG, PNG, WEBP ou GIF) com até 5 MB cada.</span>
            </div>
            <% if (error) { %>
              <p class="mt-4 rounded-xl border border-coral-500/30 bg-coral-500/10 px-4 py-3 text-sm font-semibold text-coral-600">
                <i class="fa-solid fa-circle-exclamation mr-2"></i><%= error %>
              </p>
            <% } %>
            <% if (success) { %>
              <p class="mt-4 rounded-xl border border-accent-500/30 bg-accent-500/10 px-4 py-3 text-sm font-semibold text-accent-600">
                <i class="fa-solid fa-check-circle mr-2"></i><%= success %>
              </p>
            <% } %>
            <div class="flex justify-end">
              <button type="submit" class="rounded-xl bg-accent-500 px-6 py-2.5 font-semibold text-white hover:bg-accent-600">
                Enviar comentário
              </button>
            </div>
          </form>
        </section>

        <div id="imageModal" class="fixed inset-0 bg-black bg-opacity-75 hidden items-center justify-center z-50" onclick="closeImageModal()">
          <img id="modalImage" src="" alt="Imagem ampliada" class="max-w-[90%] max-h-[90%] object-contain rounded-lg" />
          <button class="absolute top-4 right-4 text-white text-3xl hover:text-gray-300" onclick="closeImageModal()">&times;</button>
        </div>
      </main>
    </div>
  </body>
    <footer class="mt-8 border-t border-brand-200/80 bg-white/80">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-5 text-sm text-brand-700 sm:px-6 lg:px-8">
      <p>Template conceitual para testar o fluxo de um MVP de marketplace.</p>
      <div class="flex gap-4">
        <a href="/cart" class="hover:text-accent-600">Carrinho</a>
        <a href="/orders" class="hover:text-accent-600">Pedidos</a>
        <a href="/seller-dashboard" class="hover:text-accent-600">Vendedor</a>
        <a href="/admin-dashboard" class="hover:text-accent-600">Admin</a>
      </div>
    </div>
  </footer>
</html>

<script>
  function changeMainImage(src) {
    const mainImage = document.querySelector('.flex.h-80 img');
    if (mainImage) {
      mainImage.src = src;
    }
  }
  document.querySelectorAll('.like-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const productId = btn.dataset.productId;
      toggleLike(productId);
    });
  });

  async function toggleLike(productId) {
    const userId = '<%= user ? user.id : null %>';

    if (!userId) {
      window.location.href = '/login?error=Faça login para curtir produtos';
      return;
    }

    const likeBtn = document.getElementById(`like-btn-${productId}`);
    const likeIcon = document.getElementById(`like-icon-${productId}`);
    const likesCount = document.getElementById(`likes-count-${productId}`);

    likeBtn.disabled = true;
    likeBtn.style.opacity = '0.5';

    try {
      const response = await fetch(`/product-details/${productId}/like`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      const data = await response.json();

      if (response.ok) {
        if (data.liked) {
          likeIcon.className = 'fa-solid fa-heart text-2xl text-red-500';
        } else {
          likeIcon.className = 'fa-regular fa-heart text-2xl text-gray-400 hover:text-red-400';
        }

        likesCount.innerHTML = `<i class="fa-regular fa-heart mr-1"></i> ${data.totalLikes} pessoas curtiram este produto`;
      } else {
        alert(data.error || 'Erro ao processar like');
      }
    } catch (error) {
      console.error('Erro:', error);
      alert('Erro ao processar like');
    } finally {
      likeBtn.disabled = false;
      likeBtn.style.opacity = '1';
    }
  }

  function openImageModal(imageUrl) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage');
    modalImage.src = imageUrl;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeImageModal() {
    const modal = document.getElementById('imageModal');
    modal.classList.remove('flex');
    modal.classList.add('hidden');
  }

  async function deleteComment(commentId) {
    if (!confirm('Tem certeza que deseja excluir este comentário?')) {
      return;
    }

    try {
      const response = await fetch(`/product-details/${commentId}/comment`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      const data = await response.json();

      if (response.ok) {
        window.location.reload();
      } else {
        alert(data.error || 'Erro ao deletar comentário');
      }
    } catch (error) {
      console.error('Erro:', error);
      alert('Erro ao deletar comentário');
    }
  }
</script>
