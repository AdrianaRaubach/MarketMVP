<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MarketMVP | Verificar Email</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
        theme: {
            extend: {
            fontFamily: {
                display: ["Space Grotesk", "sans-serif"],
                body: ["Plus Jakarta Sans", "sans-serif"],
            },
            colors: {
                brand: { 50: "#F8F7F2", 100: "#EDE8D8", 200: "#D9CEAA", 300: "#C7B57D", 400: "#B99B56", 500: "#A8853A", 600: "#886B2F", 700: "#665024", 800: "#43361A", 900: "#251E10" },
                accent: { 500: "#0A7D7A", 600: "#075F5D" },
                coral: { 500: "#E66A4E", 600: "#C85339" },
            },
            },
        },
        };
    </script>
    <style>
        .grid-bg {
        background-image: radial-gradient(#d9ceaa 0.8px, transparent 0.8px), radial-gradient(#d9ceaa 0.8px, #f8f7f2 0.8px);
        background-size: 28px 28px;
        background-position: 0 0, 14px 14px;
        }
    </style>
</head>

<body class="font-body bg-brand-50 text-brand-900">
    <div class="min-h-screen grid-bg">
        <header class="border-b border-brand-200/80 bg-white/75 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
            <a href="/" class="font-display text-xl font-bold">MarketMVP</a>
            <nav class="flex items-center gap-3 text-sm font-semibold">
            <a href="/login" class="rounded-full border border-brand-300 px-4 py-2 hover:bg-brand-100">Entrar</a>
            </nav>
        </div>
        </header>

        <main class="mx-auto flex max-w-7xl items-center justify-center px-4 py-10 sm:px-6 lg:px-8">
        <section class="w-full max-w-md rounded-3xl border border-brand-200 bg-white p-6 shadow-sm">
            <h1 class="font-display text-3xl font-bold">Verifique seu email</h1>
            <p class="mt-1 text-sm text-brand-700">
                Enviamos um código de 6 dígitos para <strong><%= email %></strong>
            </p>
            
            <form class="mt-5 space-y-4" action="/verify-email" method="POST">
                <label class="block">
                    <span class="mb-1 block text-sm font-medium">Código de verificação</span>
                    <input 
                        type="text" 
                        name="code" 
                        placeholder="Digite o código de 6 dígitos" 
                        maxlength="6"
                        pattern="[0-9]{6}"
                        required
                        class="w-full rounded-xl border border-brand-300 px-4 py-2.5 text-center text-2xl tracking-widest outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
                    />
                </label>
                
                <button type="submit" class="w-full rounded-xl bg-brand-900 px-4 py-2.5 font-semibold text-brand-50 hover:bg-brand-800 transition-colors">
                    Verificar código
                </button>
            </form>
            
            <div class="mt-4 text-center">
                <p class="text-sm text-brand-700">
                    Não recebeu o email?
                </p>
                <form action="/resend-verification" method="POST" class="mt-2">
                    <button type="submit" class="font-semibold text-accent-600 hover:text-accent-500 underline">
                        Reenviar código
                    </button>
                </form>
                <p class="mt-2 text-xs text-brand-500">
                    O código expira em 15 minutos
                </p>
            </div>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mt-4 rounded-xl bg-red-50 p-3 text-sm text-red-700 border border-red-200">
                    <%= error %>
                </div>
            <% } %>
            
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="mt-4 rounded-xl bg-green-50 p-3 text-sm text-green-700 border border-green-200">
                    <%= success %>
                </div>
            <% } %>
        </section>
        </main>
    </div>
</body>

</html>